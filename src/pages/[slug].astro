---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, categoryBySlug } from '../consts';

export async function getStaticPaths() {
  const all = (await getCollection('articulos')).filter((a) => !a.data.draft);
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}

const { entry, all } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const cat = categoryBySlug(d.category);
const url = new URL(`/${entry.id}/`, SITE.url).href;
const fmt = (date: Date) => date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const pillar = all.find((a) => a.data.pillar && a.data.category === d.category && a.id !== entry.id);
const related = all
  .filter((a) => a.id !== entry.id && a.id !== pillar?.id)
  .sort((a, b) => Number(b.data.category === d.category) - Number(a.data.category === d.category) || Number(b.data.pillar) - Number(a.data.pillar))
  .slice(0, 3);
const toc = headings.filter((h) => h.depth === 2);

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    datePublished: d.pubDate.toISOString(),
    dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    author: { '@type': 'Person', name: SITE.owner, url: `${SITE.url}/sobre-nosotros/` },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: url,
    inLanguage: 'es-ES',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: cat.name, item: `${SITE.url}/categoria/${cat.slug}/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
if (d.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---
<Base title={d.title} description={d.description} type="article" jsonLd={jsonLd}>
  <article class="post">
    <nav class="breadcrumbs" aria-label="Migas de pan">
      <a href="/">Inicio</a> › <a href={`/categoria/${cat.slug}/`}>{cat.name}</a>
    </nav>
    <h1>{d.title}</h1>
    <p class="post-meta">
      Por <a href="/sobre-nosotros/">{SITE.owner}</a>{' · '}
      {d.updatedDate ? <>Actualizado el {fmt(d.updatedDate)}</> : <>Publicado el {fmt(d.pubDate)}</>}
    </p>
    {toc.length > 2 && (
      <nav class="toc" aria-label="Índice">
        <strong>En este artículo</strong>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}
    <Content />
    {d.faq.length > 0 && (
      <section class="faq">
        <h2>Preguntas frecuentes</h2>
        {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    )}
    <AdSlot />
    <aside class="next">
      <h2>Sigue leyendo</h2>
      <ul>
        {pillar && <li><a href={`/${pillar.id}/`}><strong>{pillar.data.title}</strong></a> (guía principal de {cat.name.toLowerCase()})</li>}
        {related.map((r) => <li><a href={`/${r.id}/`}>{r.data.title}</a></li>)}
      </ul>
    </aside>
  </article>
</Base>
